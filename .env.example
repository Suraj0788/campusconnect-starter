# Clerk: create an app at https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase: Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: configure Clerk as a Supabase third-party auth provider,
# then set the Clerk JWT template name if you use a custom template.
CLERK_SUPABASE_JWT_TEMPLATE=supabase
